# =============================================================================
# Centremix 官网后端 · 环境变量示例（复制为 .env 后填写）
# =============================================================================

# --- 服务 ---
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
API_PREFIX=/api

# --- 云端数据库 (PostgreSQL，兼容 Supabase/阿里云RDS/腾讯云PostgreSQL) ---
# 例: postgres://user:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgres://user:password@localhost:5432/centremix
# 连接池与查询防护（可选，留空用默认值）
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
# 公开接口 Cache-Control 最大年龄(秒)，<=0 禁用缓存
PUBLIC_CACHE_MAX_AGE=60

# --- JWT 鉴权 ---
# 请使用强随机值: openssl rand -hex 32
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=14d

# --- 云端对象存储 (S3 兼容，支持 Supabase Storage / 阿里云OSS / 腾讯云COS / MinIO) ---
# driver: s3 | local  (local 仅用于本地开发，不推荐生产)
STORAGE_DRIVER=s3
STORAGE_BUCKET=website
STORAGE_REGION=ap-beijing
STORAGE_ENDPOINT=https://s3.ap-beijing.amazonaws.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# 公开访问基址（CDN/公共读域名），用于拼接 media.url
STORAGE_PUBLIC_BASE=https://cdn.example.com/website
# 本地模式下的目录（STORAGE_DRIVER=local 时生效）
STORAGE_LOCAL_DIR=./uploads

# --- 限流（全局默认；登录/表单提交在路由内单独收紧为 10 次/分钟）---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=60000

# --- 安全 ---
BCRYPT_ROUNDS=12
